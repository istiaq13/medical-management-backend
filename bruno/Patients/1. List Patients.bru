meta {
  name: List Patients
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/patients?page=1&limit=10&search=&condition=&sortBy=createdAt&sortOrder=desc
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  ~search: John
  ~condition: Hypertension
  ~gender: MALE
  ~doctorId: {{doctorId}}
  ~startDate: 2026-01-01
  ~endDate: 2026-12-31
  ~sortBy: createdAt
  ~sortOrder: desc
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.body && res.body.data && res.body.data.length > 0) {
    bru.setEnvVar("patientId", res.body.data[0]._id);
  }
}

tests {
  test("List patients returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has meta pagination", function() {
    const meta = res.getBody().meta;
    expect(meta).to.have.property('page');
    expect(meta).to.have.property('limit');
    expect(meta).to.have.property('total');
  });
}

