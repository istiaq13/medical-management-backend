meta {
  name: Get Doctor by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/doctors/{{doctorId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Get doctor by ID returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Doctor object contains patientCount", function() {
    const data = res.getBody().data;
    expect(data).to.have.property('patientCount');
  });
}

