meta {
  name: List Roles
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/roles?page=1&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.body && res.body.data && res.body.data.length > 0) {
    bru.setEnvVar("roleId", res.body.data[0]._id);
  }
}

tests {
  test("List roles returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Roles array contains roles", function() {
    const data = res.getBody().data;
    expect(data).to.be.an('array');
  });
}
