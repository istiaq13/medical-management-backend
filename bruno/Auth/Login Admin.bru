meta {
  name: Login Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@example.com",
    "password": "Admin@123"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.token) {
    // In-memory runtime variable: automatically vanishes when Bruno is closed
    bru.setVar("token", res.body.data.token);
  }
}

tests {
  test("Login returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Returns auth token", function() {
    expect(res.getBody().data.token).to.be.a('string');
  });
}

